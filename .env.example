# Copy this file to .env for local development (never commit the real .env).
# On Render, these are set as environment variables instead — see README.md.

# Postgres connection string. Render provides this automatically when you
# deploy with render.yaml. For local development, point it at a local
# Postgres database, e.g.:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/branch_marketing

# The single shared password used to sign in to the app.
APP_PASSWORD=choose-a-strong-password

# Random secret used to sign the login session cookie. Any long random
# string works — Render can generate one for you automatically.
COOKIE_SECRET=change-this-to-a-long-random-string

# Port the server listens on (Render sets this automatically in production).
PORT=3000
